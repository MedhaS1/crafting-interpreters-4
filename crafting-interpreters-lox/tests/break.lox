var i = 0;
while (true) {
  if (i == 3) break;
  print i;
  i = i + 1;
}
print "after while";

for (var j = 0; j < 10; j = j + 1) {
  {
    if (j == 2) {
      break;
    }
  }
  print j;
}
print "after for";

for (var x = 0; x < 3; x = x + 1) {
  for (var y = 0; y < 3; y = y + 1) {
    if (y == 1) break;
    print x * 10 + y;
  }
}
print "after nested";
